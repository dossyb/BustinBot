{
  "name": "bustinbot",
  "version": "2.2.0",
  "type": "module",
  "description": "**BustinBot** is a general-purpose Discord bot designed to enhance community engagement through a modular approach. The bot features submodules for specific functionalities, making it easy to expand and customize for various needs. Currently, the bot includes a **Movie Night Manager** and **Weekly Task Manager** to help organize and manage movie nights for your Discord server.",
  "main": "index.js",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "cron-parser": "^5.10.2",
    "csv-parse": "^7.0.3",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.7",
    "es-toolkit": "^1.52.0",
    "firebase-admin": "^14.5.0",
    "fuse.js": "^7.5.0",
    "luxon": "^3.7.2",
    "node-cron": "^4.6.0",
    "text-table": "^0.2.0"
  },
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-bustinbot \"vitest run\"",
    "test:unit": "vitest run --project unit",
    "test:watch": "firebase emulators:exec --only firestore --project demo-bustinbot \"vitest\"",
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -s"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dossyb/BustinBot.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dossyb/BustinBot/issues"
  },
  "homepage": "https://github.com/dossyb/BustinBot#readme",
  "devDependencies": {
    "@discordjs/collection": "^2.1.1",
    "@discordjs/ws": "^1.2.3",
    "@tsconfig/node26": "^26.0.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.5",
    "@types/text-table": "^0.2.5",
    "conventional-changelog-cli": "^5.0.0",
    "discord-api-types": "^0.38.56",
    "firebase-tools": "^15.33.0",
    "fishery": "^2.4.0",
    "pure-rand": "^8.4.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "undici": "^8.11.2",
    "vitest": "^5.0.3",
    "vitest-fail-on-console": "^0.10.1"
  },
  "allowScripts": {
    "protobufjs": false,
    "re2": false,
    "@firebase/util": false,
    "esbuild": false
  },
  "overrides": {
    "uuid": "^14.0.3",
    "@opentelemetry/core": "^3.0.0",
    "superstatic": "^11.1.0"
  }
}
